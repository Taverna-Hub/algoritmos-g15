[
  {
    "id": "mqtt_input_node",
    "type": "mqtt in",
    "z": "main_flow",
    "name": "ESP32 WiFi Scan",
    "topic": "esp32/wifi/scan",
    "qos": "1",
    "datatype": "auto",
    "broker": "mqtt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 100,
    "y": 100,
    "wires": [["json_parse"]]
  },
  {
    "id": "json_parse",
    "type": "json",
    "z": "main_flow",
    "name": "Parse JSON",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 300,
    "y": 100,
    "wires": [["validate_data"]]
  },
  {
    "id": "validate_data",
    "type": "function",
    "z": "main_flow",
    "name": "Validate WiFi Data",
    "func": "// Validate incoming probe request packets\nconst payload = msg.payload || {};\nconst packets = Array.isArray(payload.packets) ? payload.packets : [];\n\nif (packets.length === 0) {\n    node.error(\"Invalid probe packet format\");\n    return null;\n}\n\nlet validatedDevices = [];\nfor (let packet of packets) {\n    const mac = packet.source_mac || packet.mac || packet.sa;\n    if (mac && typeof mac === 'string') {\n        // Ensure MAC format is correct (XX:XX:XX:XX:XX:XX)\n        if (/^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$/.test(mac)) {\n            validatedDevices.push({\n                mac: mac.toUpperCase(),\n                ssid: packet.ssid || \"\",\n                rssi: parseInt(packet.rssi) || -80,\n                frequency: parseInt(packet.frequency) || 2412,\n                channel: parseInt(packet.channel) || 1,\n                subtype: packet.subtype || \"probe_request\"\n            });\n        }\n    }\n}\n\nif (validatedDevices.length === 0) {\n    node.warn(\"No valid probe packets in capture\");\n    return null;\n}\n\nmsg.payload = {\n    timestamp: payload.timestamp || new Date().toISOString(),\n    devices: validatedDevices\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 500,
    "y": 100,
    "wires": [["debug_validate", "mqtt_output"]]
  },
  {
    "id": "debug_validate",
    "type": "debug",
    "z": "main_flow",
    "name": "Debug - Validated Data",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 700,
    "y": 50,
    "wires": []
  },
  {
    "id": "mqtt_output",
    "type": "mqtt out",
    "z": "main_flow",
    "name": "Publish to Backend",
    "topic": "nodered/wifi/data",
    "qos": "1",
    "retain": false,
    "broker": "mqtt_broker",
    "x": 700,
    "y": 100,
    "wires": []
  },
  {
    "id": "error_handler",
    "type": "catch",
    "z": "main_flow",
    "name": "Error Handler",
    "scope": ["json_parse", "validate_data"],
    "uncaught": false,
    "x": 300,
    "y": 200,
    "wires": [["error_debug", "error_mqtt"]]
  },
  {
    "id": "error_debug",
    "type": "debug",
    "z": "main_flow",
    "name": "Debug - Errors",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "error",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 500,
    "y": 200,
    "wires": []
  },
  {
    "id": "error_mqtt",
    "type": "mqtt out",
    "z": "main_flow",
    "name": "Publish Error",
    "topic": "nodered/errors",
    "qos": "1",
    "retain": false,
    "broker": "mqtt_broker",
    "x": 700,
    "y": 200,
    "wires": []
  },
  {
    "id": "mqtt_broker",
    "type": "mqtt-broker",
